      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__preview_start"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror *)",
      "Bash(git branch -D main)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge * --admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/../ys-os/.claude/hooks/require-agent-model.sh\"; if [ -f \"$h\" ]; then exec bash \"$h\"; fi; echo \"ys-os hook: $h が無い。ys-os をこのrepoの隣に clone する。model の有無を見られないので通さない（ADAPTIVE_QA.md §6-2）\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$(cat)\"; case \"$p\" in *push*|*merge*) ;; *) exit 0 ;; esac; h=\"$CLAUDE_PROJECT_DIR/../ys-os/.claude/hooks/guard-push-merge.sh\"; if [ -f \"$h\" ]; then printf '%s' \"$p\" | bash \"$h\"; exit $?; fi; echo \"ys-os hook: $h が無い。ys-os をこのrepoの隣に clone する。push / merge の宛先を見られないので通さない（ADAPTIVE_QA.md §6-2）\" >&2; exit 2"
          }
        ]
      }
    ]
  }
}
